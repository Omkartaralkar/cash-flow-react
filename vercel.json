{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/transactions/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/transactions",
      "destination": "/api/index"
    },
    {
      "source": "/people/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/people",
      "destination": "/api/index"
    },
    {
      "source": "/reports",
      "destination": "/api/index"
    },
    {
      "source": "/debug-data",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}