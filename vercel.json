{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/transactions/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/people/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/reports/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}